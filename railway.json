{
  "build": {
    "strategy": "docker",
    "dockerfilePath": "backend/Dockerfile",
    "context": "backend"
  },
  "deploy": {
    "startCommand": "uvicorn main:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE"
  }
}
